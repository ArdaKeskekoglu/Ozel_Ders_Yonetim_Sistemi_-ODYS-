@model PendingAttendanceListViewModel
@{
    ViewData["Title"] = "Bekleyen Yoklama ve Devamsızlık Ücret Kararları";
}

<!-- Üst Başlık ve Filtre Çubuğu (FR-060..FR-068) -->
<section class="odys-card p-4 mb-4">
    <div class="d-flex flex-column flex-xl-row justify-content-between align-items-start align-items-xl-center gap-3">
        <div>
            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                <span class="odys-status-pill odys-status-warning">Yoklama &amp; Ücret Kararı Merkezi</span>
                @if (Model.FilterWeekRangeTitle is not null)
                {
                    <span class="badge bg-primary-subtle text-primary-emphasis rounded-pill px-3 py-1">
                        Hafta Filtresi: @Model.FilterWeekRangeTitle
                    </span>
                }
                else
                {
                    <span class="badge bg-secondary-subtle text-secondary-emphasis rounded-pill px-3 py-1">
                        Tüm Geçmiş Bekleyenler
                    </span>
                }
            </div>
            <div class="d-flex align-items-center gap-1">
                <h1 class="h4 fw-bold mb-0">Yoklama Doğrulaması ve Devamsızlık Ücret Kararları</h1>
                @await Html.PartialAsync("_InfoPopover", new KeyValuePair<string, string>(
                    "Yoklama ve devamsızlık ücret kuralı",
                    "Ders saati geçtiğinde sistem dersi otomatik olarak tamamlandı saymaz (BR-01, FR-060) ve öğrenci gelmediğinde otomatik borç oluşturmaz (BR-02, FR-066). Yoklamaları ve gelmeyen dersler için ücret kararlarını buradan tamamlayabilirsiniz."))
            </div>
        </div>

        <div class="d-flex flex-wrap align-items-center gap-2">
            @if (Model.FilterWeekStartDate.HasValue)
            {
                <a class="btn btn-outline-primary odys-touch-target px-3"
                   asp-controller="Schedule"
                   asp-action="PendingAttendance">
                    Tüm Bekleyenleri Göster
                </a>
                <a class="btn btn-outline-secondary odys-touch-target px-3"
                   asp-controller="Schedule"
                   asp-action="Index"
                   asp-route-date="@Model.FilterWeekStartDate.Value.ToString("yyyy-MM-dd")">
                    ← Haftalık Takvime Dön
                </a>
            }
            else
            {
                <a class="btn btn-outline-secondary odys-touch-target px-3"
                   asp-controller="Schedule"
                   asp-action="Index">
                    ← Haftalık Takvime Dön
                </a>
            }
        </div>
    </div>

    <hr class="my-3" />

    <!-- Özet Metrikleri -->
    <div class="row g-3">
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="p-3 rounded-3 bg-light border h-100">
                <div class="small text-muted">Yoklama Bekleyen Oturum</div>
                <div class="h5 fw-bold @(Model.TotalPendingCount > 0 ? "text-warning-emphasis" : "") mb-0">
                    @Model.TotalPendingCount Ders
                </div>
                <div class="small text-muted mt-1">Bitiş saati geçmiş ve henüz işaretlenmemiş</div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="p-3 rounded-3 bg-light border h-100">
                <div class="small text-muted">Ücret Kararı Bekleyen Devamsızlık</div>
                <div class="h5 fw-bold @(Model.PendingFeeDecisionCount > 0 ? "text-danger-emphasis" : "") mb-0">
                    @Model.PendingFeeDecisionCount Ders
                </div>
                <div class="small text-muted mt-1">Öğrenci gelmedi • Otomatik borç oluşturulmadı</div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="p-3 rounded-3 bg-light border h-100">
                <div class="small text-muted">Toplam Bekleyen Ders Süresi</div>
                <div class="h5 fw-bold mb-0">@Model.TotalPendingMinutes Dakika</div>
                <div class="small text-muted mt-1">(@Math.Round(Model.TotalPendingMinutes / 60.0, 1) saat)</div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="p-3 rounded-3 bg-light border h-100">
                <div class="small text-muted">Bekleyen Oturum Ücreti Snapshot Toplamı</div>
                <div class="h5 fw-bold text-primary mb-0">@Model.TotalPendingFeeSnapshot.ToString("N2") ₺</div>
                <div class="small text-muted mt-1">Onaylandığında geçerli olacak dondurulmuş ders tutarı</div>
            </div>
        </div>
    </div>
</section>

@if (Model.PendingFeeDecisionCount > 0)
{
    <!-- Devamsızlıkta Ücret Kararı Bekleyen Dersler (FR-065..FR-068, BR-02, BR-03) -->
    <section class="odys-card p-4 mb-4 border-warning" aria-label="Devamsızlıkta Ücret Kararı Bekleyen Dersler">
        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-start align-items-lg-center gap-2 mb-3">
            <div>
                <h2 class="h5 fw-bold mb-1">Devamsızlıkta Ücret Kararı Bekleyen Dersler (@Model.PendingFeeDecisionCount)</h2>
                <p class="small text-muted mb-0">
                    Öğrencinin gelmediği derslerden otomatik borç oluşturulmaz (FR-066). Her ders için ücret alınıp alınmayacağını aşağıdan seçebilirsiniz.
                </p>
            </div>
        </div>

        <div class="row g-3">
            @foreach (var item in Model.PendingFeeDecisionItems)
            {
                <div class="col-12 col-md-6 col-xl-4">
                    <div class="p-3 rounded-3 border bg-light h-100 d-flex flex-column justify-content-between gap-2">
                        <div>
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="small fw-bold">@item.LessonDate.ToString("dd.MM.yyyy") • @item.TimeRangeText</span>
                                <span class="badge bg-warning-subtle text-warning-emphasis rounded-pill">Gelmedi • Ücret Kararı Bekliyor</span>
                            </div>
                            <div class="fw-semibold">
                                <a class="text-decoration-none"
                                   asp-controller="Schedule"
                                   asp-action="Details"
                                   asp-route-id="@item.LessonId">
                                    @item.StudentFullName — @item.SubjectName
                                </a>
                            </div>
                            <div class="small text-muted">
                                @item.DurationMinutes dk • Snapshot Tutar: <strong>@item.SessionFeeSnapshot.ToString("N2") ₺</strong>
                            </div>
                        </div>

                        <div class="pt-2 border-top">
                            <div class="small fw-semibold mb-2">Bu derste ücret alınacak mı?</div>
                            <div class="d-flex flex-wrap gap-2">
                                <form asp-controller="Schedule" asp-action="SetFeeDecision" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="LessonId" value="@item.LessonId" />
                                    <input type="hidden" name="FeeDecision" value="@LessonFeeDecision.Waive" />
                                    <input type="hidden" name="ReturnToPendingCenter" value="true" />
                                    @if (Model.FilterWeekStartDate.HasValue)
                                    {
                                        <input type="hidden" name="ReturnDate" value="@Model.FilterWeekStartDate.Value.ToString("yyyy-MM-dd")" />
                                    }
                                    <button type="submit" class="btn btn-outline-secondary btn-sm px-3">
                                        Hayır — Ücret Alınmayacak (0 ₺)
                                    </button>
                                </form>

                                <form asp-controller="Schedule" asp-action="SetFeeDecision" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="LessonId" value="@item.LessonId" />
                                    <input type="hidden" name="FeeDecision" value="@LessonFeeDecision.Charge" />
                                    <input type="hidden" name="ReturnToPendingCenter" value="true" />
                                    @if (Model.FilterWeekStartDate.HasValue)
                                    {
                                        <input type="hidden" name="ReturnDate" value="@Model.FilterWeekStartDate.Value.ToString("yyyy-MM-dd")" />
                                    }
                                    <button type="submit" class="btn btn-primary btn-sm px-3">
                                        Evet — Ücret Al (@item.SessionFeeSnapshot.ToString("N0") ₺)
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>
}

@if (Model.TotalPendingCount == 0 && Model.PendingFeeDecisionCount == 0)
{
    <section class="odys-card p-5 text-center">
        <div class="h5 fw-bold mb-2">Bekleyen yoklama veya ücret kararı işleminiz bulunmuyor</div>
        <p class="text-muted small mb-4">
            Saati geçmiş tüm ders oturumlarınızın yoklama ve devamsızlık ücret kararları tamamlanmış durumda.
        </p>
        <a class="btn btn-primary odys-touch-target px-4"
           asp-controller="Schedule"
           asp-action="Index"
           asp-route-date="@(Model.FilterWeekStartDate?.ToString("yyyy-MM-dd"))">
            Haftalık Takvime Dön
        </a>
    </section>
}
else if (Model.TotalPendingCount > 0)
{
    <!-- Toplu Yoklama Tamamlama Kartı (FR-063, FR-064) -->
    <section class="odys-card p-4 mb-4" aria-label="Toplu Yoklama Tamamlama">
        <form asp-controller="Schedule"
              asp-action="BatchRecordAttendance"
              method="post"
              id="batchAttendanceForm">
            @Html.AntiForgeryToken()
            @if (Model.FilterWeekStartDate.HasValue)
            {
                <input type="hidden" name="FilterDate" value="@Model.FilterWeekStartDate.Value.ToString("yyyy-MM-dd")" />
            }

            <div class="d-flex flex-column flex-xl-row justify-content-between align-items-start align-items-xl-end gap-3 mb-3 pb-3 border-bottom">
                <div class="flex-grow-1">
                    <h2 class="h5 fw-bold mb-1">Seçili Derslerin Yoklamasını Topluca Tamamla</h2>
                    <p class="small text-muted mb-0">
                        Tablodan işaretlediğiniz derslerin tamamını tek işlemde <strong>Öğrenci Geldi</strong>, <strong>Öğrenci Gelmedi</strong> veya <strong>Ders İptal Edildi</strong> olarak kaydedebilirsiniz.
                    </p>
                </div>

                <div class="d-flex flex-wrap align-items-end gap-2 w-100 w-xl-auto">
                    <div>
                        <label for="batchAttendanceStatus" class="form-label small fw-semibold mb-1">Toplu Yoklama Durumu</label>
                        <select id="batchAttendanceStatus"
                                name="AttendanceStatus"
                                class="form-select form-select-sm odys-touch-target">
                            <option value="@LessonAttendanceStatus.Attended" selected>✓ Öğrenci Geldi (Ders Tamamlandı)</option>
                            <option value="@LessonAttendanceStatus.Absent">✕ Öğrenci Gelmedi (Ücret Kararı Ayrı Seçilir)</option>
                            <option value="@LessonAttendanceStatus.NotApplicable">⊘ Ders İptal Edildi</option>
                        </select>
                    </div>

                    <div class="flex-grow-1" style="min-width: 220px;">
                        <label for="batchAttendanceNote" class="form-label small fw-semibold mb-1">Toplu Açıklama / Not (İsteğe Bağlı)</label>
                        <input type="text"
                               id="batchAttendanceNote"
                               name="AttendanceNote"
                               maxlength="500"
                               class="form-control form-control-sm odys-touch-target"
                               placeholder="Örn: Gün sonu toplu yoklama onayı..." />
                    </div>

                    <button type="submit" class="btn btn-primary odys-touch-target px-4 fw-semibold">
                        Seçili Dersleri Kaydet
                    </button>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col" style="width: 44px;">
                                <input type="checkbox"
                                       class="form-check-input"
                                       id="selectAllPendingLessons"
                                       checked
                                       aria-label="Tüm bekleyen dersleri seç"
                                       onclick="document.querySelectorAll('.pending-lesson-checkbox').forEach(cb => cb.checked = this.checked);" />
                            </th>
                            <th scope="col">Tarih &amp; Gün</th>
                            <th scope="col">Saat Aralığı</th>
                            <th scope="col">Öğrenci</th>
                            <th scope="col">Ders Türü</th>
                            <th scope="col">Süre &amp; Ücret (Snapshot)</th>
                            <th scope="col">Durum</th>
                            <th scope="col" class="text-end">Tekil Hızlı İşlem</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>
                                    <input type="checkbox"
                                           class="form-check-input pending-lesson-checkbox"
                                           name="LessonIds"
                                           value="@item.LessonId"
                                           checked
                                           aria-label="@item.StudentFullName - @item.SubjectName (@item.LessonDate.ToString("dd.MM.yyyy")) dersini seç" />
                                </td>
                                <td>
                                    <div class="fw-semibold">@item.LessonDate.ToString("dd.MM.yyyy")</div>
                                    <div class="small text-muted">@item.DayNameTr</div>
                                </td>
                                <td class="fw-semibold">@item.TimeRangeText</td>
                                <td>
                                    <a class="fw-semibold text-decoration-none"
                                       asp-controller="Students"
                                       asp-action="Details"
                                       asp-route-id="@item.StudentId">
                                        @item.StudentFullName
                                    </a>
                                </td>
                                <td>
                                    <span class="odys-student-subject">@item.SubjectName</span>
                                </td>
                                <td>
                                    <div class="fw-semibold text-primary">@item.SessionFeeSnapshot.ToString("N2") ₺</div>
                                    <div class="small text-muted">@item.DurationMinutes dk (@item.HourlyRateSnapshot.ToString("N0") ₺/sa)</div>
                                </td>
                                <td>
                                    <span class="badge rounded-pill bg-warning-subtle text-warning-emphasis">
                                        Yoklama Bekliyor
                                    </span>
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex flex-wrap justify-content-end gap-1">
                                        <a class="btn btn-outline-primary btn-sm px-2"
                                           asp-controller="Schedule"
                                           asp-action="Details"
                                           asp-route-id="@item.LessonId">
                                            Detay / Yoklama
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </form>
    </section>

    <!-- Tekil Hızlı Yoklama Kartları -->
    <section class="odys-card p-4" aria-label="Tekil Hızlı Yoklama Girişi">
        <h2 class="h6 fw-bold mb-3">Tek Tıkla Tekil Yoklama Girişi</h2>
        <div class="row g-3">
            @foreach (var item in Model.Items)
            {
                <div class="col-12 col-md-6 col-xl-4">
                    <div class="p-3 rounded-3 border bg-light h-100 d-flex flex-column justify-content-between gap-2">
                        <div>
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="small fw-bold">@item.LessonDate.ToString("dd.MM.yyyy") • @item.TimeRangeText</span>
                                <span class="badge bg-warning-subtle text-warning-emphasis rounded-pill">Bekliyor</span>
                            </div>
                            <div class="fw-semibold">@item.StudentFullName — @item.SubjectName</div>
                            <div class="small text-muted">@item.DurationMinutes dk • @item.SessionFeeSnapshot.ToString("N2") ₺</div>
                        </div>

                        <div class="d-flex flex-wrap gap-1 pt-2 border-top">
                            <form asp-controller="Schedule" asp-action="RecordAttendance" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="LessonId" value="@item.LessonId" />
                                <input type="hidden" name="AttendanceStatus" value="@LessonAttendanceStatus.Attended" />
                                <input type="hidden" name="ReturnToPendingCenter" value="true" />
                                @if (Model.FilterWeekStartDate.HasValue)
                                {
                                    <input type="hidden" name="ReturnDate" value="@Model.FilterWeekStartDate.Value.ToString("yyyy-MM-dd")" />
                                }
                                <button type="submit" class="btn btn-success btn-sm px-2">✓ Geldi</button>
                            </form>

                            <form asp-controller="Schedule" asp-action="RecordAttendance" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="LessonId" value="@item.LessonId" />
                                <input type="hidden" name="AttendanceStatus" value="@LessonAttendanceStatus.Absent" />
                                <input type="hidden" name="ReturnToPendingCenter" value="true" />
                                @if (Model.FilterWeekStartDate.HasValue)
                                {
                                    <input type="hidden" name="ReturnDate" value="@Model.FilterWeekStartDate.Value.ToString("yyyy-MM-dd")" />
                                }
                                <button type="submit" class="btn btn-outline-danger btn-sm px-2">✕ Gelmedi</button>
                            </form>

                            <form asp-controller="Schedule" asp-action="RecordAttendance" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="LessonId" value="@item.LessonId" />
                                <input type="hidden" name="AttendanceStatus" value="@LessonAttendanceStatus.NotApplicable" />
                                <input type="hidden" name="ReturnToPendingCenter" value="true" />
                                @if (Model.FilterWeekStartDate.HasValue)
                                {
                                    <input type="hidden" name="ReturnDate" value="@Model.FilterWeekStartDate.Value.ToString("yyyy-MM-dd")" />
                                }
                                <button type="submit" class="btn btn-outline-secondary btn-sm px-2">İptal</button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>
}
