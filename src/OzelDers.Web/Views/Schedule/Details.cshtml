@model LessonDetailsViewModel
@{
    ViewData["Title"] = $"{Model.StudentFullName} — {Model.SubjectName} Ders Detayı";
}

<!-- Üst Başlık ve Hızlı İşlemler (FR-044, FR-047) -->
<section class="odys-card p-4 mb-4">
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-start align-items-lg-center gap-3">
        <div>
            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                <span class="odys-status-pill odys-status-active">Ders Oturumu Detayı</span>
                <span class="badge rounded-pill @Model.StatusBadgeCssClass px-3 py-1">
                    @Model.StatusBadgeText
                </span>
            </div>
            <h1 class="h4 fw-bold mb-1">
                @Model.StudentFullName — @Model.SubjectName
            </h1>
            <p class="small text-muted mb-0">
                @Model.LessonDate.ToString("dd.MM.yyyy") (@Model.DayNameTr) • Saat: <strong>@Model.TimeRangeText</strong> (@Model.DurationMinutes dakika)
            </p>
        </div>

        <div class="d-flex flex-wrap align-items-center gap-2">
            <a class="btn btn-outline-secondary odys-touch-target px-3"
               asp-controller="Schedule"
               asp-action="Index"
               asp-route-date="@Model.WeekStartDate.ToString("yyyy-MM-dd")">
                ← Haftalık Takvim
            </a>
            <a class="btn btn-outline-dark odys-touch-target px-3"
               asp-controller="Students"
               asp-action="Details"
               asp-route-id="@Model.StudentId">
                Öğrenci Kartı
            </a>

            @if (Model.IsCancelled)
            {
                <form asp-controller="Schedule"
                      asp-action="Restore"
                      asp-route-id="@Model.LessonId"
                      method="post"
                      class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnDate" value="@Model.WeekStartDate.ToString("yyyy-MM-dd")" />
                    <button type="submit" class="btn btn-success odys-touch-target px-3 fw-semibold">
                        Yeniden Planlı Duruma Al
                    </button>
                </form>
            }
            else if (!Model.IsCompleted)
            {
                <a class="btn btn-primary odys-touch-target px-3 fw-semibold"
                   asp-controller="Schedule"
                   asp-action="Edit"
                   asp-route-id="@Model.LessonId">
                    Yalnızca Bu Haftayı Düzenle / Taşı
                </a>
                <a class="btn btn-outline-info odys-touch-target px-3"
                   asp-controller="Schedule"
                   asp-action="Reschedule"
                   asp-route-id="@Model.LessonId">
                    Ertele
                </a>
                <form asp-controller="Schedule"
                      asp-action="Cancel"
                      asp-route-id="@Model.LessonId"
                      method="post"
                      class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnDate" value="@Model.WeekStartDate.ToString("yyyy-MM-dd")" />
                    <button type="submit" class="btn btn-outline-secondary odys-touch-target px-3">
                        Bu Haftayı İptal Et
                    </button>
                </form>
            }
        </div>
    </div>

    <hr class="my-3" />

    <!-- Özet Bilgi Kartları -->
    <div class="row g-3">
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="p-3 rounded-3 bg-light border h-100">
                <div class="small text-muted">Ders Türü (Tekil Oturum)</div>
                <div class="h5 fw-bold mb-0">@Model.SubjectName</div>
                @if (Model.IsTeacherDefaultSubject)
                {
                    <div class="small text-primary mt-1">★ Varsayılan ders türünüz</div>
                }
            </div>
        </div>
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="p-3 rounded-3 bg-light border h-100">
                <div class="small text-muted">Tarih ve Saat Aralığı</div>
                <div class="h5 fw-bold mb-0">@Model.TimeRangeText</div>
                <div class="small text-muted mt-1">@Model.LessonDate.ToString("dd.MM.yyyy") • @Model.DayNameTr (@Model.DurationMinutes dk)</div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="p-3 rounded-3 bg-light border h-100">
                <div class="small text-muted">Oturum Ücreti (Snapshot)</div>
                <div class="h5 fw-bold text-primary mb-0">@Model.SessionFeeSnapshot.ToString("N2") ₺</div>
                <div class="small text-muted mt-1">Saatlik snapshot: @Model.HourlyRateSnapshot.ToString("N2") ₺ / 60 dk</div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="p-3 rounded-3 bg-light border h-100">
                <div class="small text-muted">Tek Hafta İstisnası Kuralı</div>
                <div class="small fw-semibold mt-1">
                    Bu oturumda yapacağınız gün/saat veya iptal değişiklikleri yalnızca <strong>@Model.LessonDate.ToString("dd.MM.yyyy")</strong> haftasını etkiler; diğer haftalar korunur.
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Yoklama ve Ders Gerçekleşme Durumu Kartı (FR-057..FR-062) -->
<section class="odys-card p-4 mb-4" aria-label="Yoklama ve Ders Gerçekleşme Durumu">
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-start align-items-lg-center gap-3 mb-3">
        <div>
            <div class="d-flex align-items-center gap-1">
                <h2 class="h5 fw-bold mb-0">Yoklama ve Ders Gerçekleşme Durumu</h2>
                @await Html.PartialAsync("_InfoPopover", new KeyValuePair<string, string>(
                    "Yoklama ve gerçekleşme durumu",
                    "Ders saati geçtiğinde ders otomatik olarak tamamlandı sayılmaz (FR-060). Öğrencinin derse gelip gelmediğini veya dersin iptal durumunu buradan kaydedebilir ve sonradan güncelleyebilirsiniz."))
            </div>
            <p class="small text-muted mb-0 mt-1">
                Mevcut yoklama durumu: <strong>@Model.AttendanceBadgeText</strong>
                @if (Model.AttendanceVerifiedAtUtc.HasValue)
                {
                    <span>• Doğrulanma zamanı: @Model.AttendanceVerifiedAtUtc.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
                }
            </p>
        </div>

        <a class="btn btn-outline-warning text-dark btn-sm odys-touch-target px-3 fw-semibold"
           asp-controller="Schedule"
           asp-action="PendingAttendance"
           asp-route-date="@Model.WeekStartDate.ToString("yyyy-MM-dd")">
            Bu Haftanın Bekleyen Yoklamaları
        </a>
    </div>

    <form asp-controller="Schedule"
          asp-action="RecordAttendance"
          method="post"
          class="row g-3 align-items-end">
        @Html.AntiForgeryToken()
        <input type="hidden" name="LessonId" value="@Model.LessonId" />
        <input type="hidden" name="ReturnToDetails" value="true" />
        <input type="hidden" name="ReturnDate" value="@Model.WeekStartDate.ToString("yyyy-MM-dd")" />

        <div class="col-12 col-md-4">
            <label for="AttendanceStatus" class="form-label small fw-semibold">Katılım ve Gerçekleşme Seçimi</label>
            <select id="AttendanceStatus"
                    name="AttendanceStatus"
                    class="form-select odys-touch-target">
                <option value="@LessonAttendanceStatus.Attended" selected="@(Model.AttendanceStatus == LessonAttendanceStatus.Attended || Model.AttendanceStatus == LessonAttendanceStatus.Pending)">
                    ✓ Öğrenci Geldi (Ders Gerçekleşti)
                </option>
                <option value="@LessonAttendanceStatus.Absent" selected="@(Model.AttendanceStatus == LessonAttendanceStatus.Absent)">
                    ✕ Öğrenci Gelmedi (Devamsızlık)
                </option>
                <option value="@LessonAttendanceStatus.NotApplicable" selected="@(Model.AttendanceStatus == LessonAttendanceStatus.NotApplicable)">
                    ⊘ Ders İptal Edildi
                </option>
                <option value="@LessonAttendanceStatus.Pending">
                    ⏳ Yoklama Bekliyor Durumuna Geri Al
                </option>
            </select>
        </div>

        <div class="col-12 col-md-5">
            <label for="AttendanceNote" class="form-label small fw-semibold">Yoklama / Katılım Notu (İsteğe Bağlı)</label>
            <input type="text"
                   id="AttendanceNote"
                   name="AttendanceNote"
                   maxlength="500"
                   class="form-control odys-touch-target"
                   placeholder="Örn: Öğrenci zamanında geldi / Veli bilgi verdi..." />
        </div>

        <div class="col-12 col-md-3 d-grid">
            <button type="submit" class="btn btn-primary odys-touch-target fw-semibold">
                Yoklama Durumunu Kaydet
            </button>
        </div>
    </form>
</section>

<!-- Detaylı Oturum Bilgileri ve Notlar -->
<div class="row g-4 mb-4">
    <div class="col-12 col-lg-6">
        <section class="odys-card p-4 h-100" aria-label="Oturum ve Öğrenci Bilgileri">
            <h2 class="h5 fw-bold mb-3">Oturum ve Öğrenci Bilgileri</h2>
            <dl class="row mb-0 small">
                <dt class="col-sm-4 text-muted py-2 border-bottom">Öğrenci</dt>
                <dd class="col-sm-8 fw-semibold py-2 border-bottom mb-0">
                    <a class="text-decoration-none"
                       asp-controller="Students"
                       asp-action="Details"
                       asp-route-id="@Model.StudentId">
                        @Model.StudentFullName
                    </a>
                </dd>

                <dt class="col-sm-4 text-muted py-2 border-bottom">İletişim</dt>
                <dd class="col-sm-8 py-2 border-bottom mb-0">
                    @(string.IsNullOrWhiteSpace(Model.StudentPhoneNumber) ? "Telefon belirtilmedi" : Model.StudentPhoneNumber)
                    @if (!string.IsNullOrWhiteSpace(Model.StudentEmail))
                    {
                        <span class="text-muted"> • @Model.StudentEmail</span>
                    }
                </dd>

                <dt class="col-sm-4 text-muted py-2 border-bottom">Ders Türü</dt>
                <dd class="col-sm-8 fw-semibold py-2 border-bottom mb-0">@Model.SubjectName</dd>

                <dt class="col-sm-4 text-muted py-2 border-bottom">Dondurulmuş Ücret</dt>
                <dd class="col-sm-8 py-2 border-bottom mb-0">
                    <strong>@Model.SessionFeeSnapshot.ToString("N2") ₺</strong>
                    <span class="text-muted">(@Model.HourlyRateSnapshot.ToString("N2") ₺/saat × @Model.DurationMinutes dk)</span>
                </dd>

                <dt class="col-sm-4 text-muted pt-2">Kayıt / Güncelleme</dt>
                <dd class="col-sm-8 pt-2 mb-0">
                    Oluşturulma: @Model.CreatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                    @if (Model.UpdatedAtUtc.HasValue)
                    {
                        <span class="text-muted d-block">
                            Son güncelleme: @Model.UpdatedAtUtc.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                        </span>
                    }
                </dd>
            </dl>
        </section>
    </div>

    <div class="col-12 col-lg-6">
        <section class="odys-card p-4 h-100 d-flex flex-column justify-content-between" aria-label="Ders Notu ve Tarihçe İzi">
            <div>
                <h2 class="h5 fw-bold mb-2">Ders Oturumu Notu ve Tarihçe İzi</h2>
                <p class="small text-muted mb-3">
                    Bu oturuma özel konu notları, erteleme geçmişi veya iptal açıklamaları aşağıda yer alır.
                </p>

                @if (string.IsNullOrWhiteSpace(Model.Notes))
                {
                    <div class="p-3 rounded-3 bg-light border text-muted small">
                        Bu ders oturumu için henüz bir not veya erteleme açıklaması girilmemiş.
                    </div>
                }
                else
                {
                    <div class="p-3 rounded-3 bg-light border small">
                        @Model.Notes
                    </div>
                }
            </div>

            @if (!Model.IsCompleted)
            {
                <div class="mt-3 pt-3 border-top d-flex justify-content-between align-items-center">
                    <span class="small text-muted">Planlı kaydı tamamen silmek isterseniz:</span>
                    <form asp-controller="Schedule"
                          asp-action="Delete"
                          asp-route-id="@Model.LessonId"
                          method="post"
                          class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="returnDate" value="@Model.WeekStartDate.ToString("yyyy-MM-dd")" />
                        <button type="submit" class="btn btn-outline-danger btn-sm odys-touch-target px-3">
                            Bu Oturum Kaydını Kaldır
                        </button>
                    </form>
                </div>
            }
        </section>
    </div>
</div>

<!-- Aynı Öğrenci ve Ders Türünün Diğer Haftalardaki İlişkili Oturumları (FR-046, FR-047) -->
<section class="odys-card p-4" aria-label="Diğer Haftalardaki İlişkili Ders Oturumları">
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2 mb-3">
        <div>
            <h2 class="h5 fw-bold mb-1">@Model.StudentFullName — @Model.SubjectName Diğer Haftalardaki Oturumları</h2>
            <p class="small text-muted mb-0">
                Tekrarlayan haftalık derslerin her biri bağımsız bir oturum kaydıdır; herhangi bir haftayı tek başına düzenleyebilir veya iptal edebilirsiniz.
            </p>
        </div>
        <a class="btn btn-outline-primary btn-sm odys-touch-target px-3"
           asp-controller="Schedule"
           asp-action="Create"
           asp-route-studentId="@Model.StudentId">
            + Yeni Haftalık Ders Ekle
        </a>
    </div>

    @if (Model.RelatedSeriesLessons.Count == 0)
    {
        <div class="p-3 rounded-3 bg-light border text-muted small">
            Bu öğrenci ve ders türü için başka bir haftada kayıtlı başka ders oturumu bulunmuyor.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Tarih</th>
                        <th scope="col">Saat Aralığı</th>
                        <th scope="col">Süre</th>
                        <th scope="col">Ücret (Snapshot)</th>
                        <th scope="col">Durum</th>
                        <th scope="col">Not / Tarihçe</th>
                        <th scope="col" class="text-end">İşlem</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.RelatedSeriesLessons)
                    {
                        <tr>
                            <td class="fw-semibold">@item.StartLocal.ToString("dd.MM.yyyy")</td>
                            <td>@item.TimeRangeText</td>
                            <td>@item.DurationMinutes dk</td>
                            <td>@item.SessionFeeSnapshot.ToString("N2") ₺</td>
                            <td>
                                <span class="badge rounded-pill @item.StatusBadgeCssClass">
                                    @item.StatusBadgeText
                                </span>
                            </td>
                            <td class="small text-muted" style="max-width: 260px;">
                                <span class="d-inline-block text-truncate" style="max-width: 260px;">
                                    @(string.IsNullOrWhiteSpace(item.Notes) ? "—" : item.Notes)
                                </span>
                            </td>
                            <td class="text-end">
                                <a class="btn btn-outline-primary btn-sm odys-touch-target px-3"
                                   asp-controller="Schedule"
                                   asp-action="Details"
                                   asp-route-id="@item.LessonId">
                                    Detay
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
