@model CreateLessonViewModel
@{
    ViewData["Title"] = "Takvime Yeni Ders Oturumu Ekle";
}

<div class="row justify-content-center py-3">
    <div class="col-12 col-md-9 col-lg-7 col-xl-6">
        <div class="odys-card p-4">
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2 mb-4 border-bottom pb-3">
                <div>
                    <span class="odys-status-pill odys-status-active mb-2">Manuel Ders Planlama</span>
                    <h1 class="h4 fw-bold mb-1">Yeni Ders Oturumu Ekle</h1>
                    <p class="small text-muted mb-0">
                        Her ders oturumu yalnızca tek bir öğrenciye ve o öğrenciye atanmış tek bir ders türüne bağlanır.
                    </p>
                </div>
                <a class="btn btn-outline-secondary btn-sm odys-touch-target px-3"
                   asp-controller="Schedule"
                   asp-action="Index"
                   asp-route-date="@Model.LessonDate.ToString("yyyy-MM-dd")">
                    ← Haftalık Takvim
                </a>
            </div>

            @if (!Model.HasAvailableEnrollments)
            {
                <div class="p-4 text-center bg-light rounded-3 border">
                    <div class="display-6 mb-2" aria-hidden="true">📚</div>
                    <h2 class="h6 fw-bold mb-2">Ders eklenebilecek aktif öğrenci–ders türü eşleşmesi bulunamadı</h2>
                    <p class="text-muted small mb-3">
                        Takvime ders oturumu ekleyebilmek için önce aktif bir öğrencinize en az bir ders türü ve saatlik ücret tanımlamalısınız.
                    </p>
                    <a class="btn btn-primary odys-touch-target px-4 fw-semibold"
                       asp-controller="Students"
                       asp-action="Index">
                        Öğrencilere Git ve Ders Türü Ata
                    </a>
                </div>
            }
            else
            {
                <form asp-controller="Schedule" asp-action="Create" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="PreselectedStudentId" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="StudentSubjectId" class="form-label fw-semibold"></label>
                            <select asp-for="StudentSubjectId" id="studentSubjectSelect" class="form-select">
                                @foreach (var option in Model.AvailableEnrollments)
                                {
                                    <option value="@option.StudentSubjectId"
                                            data-duration="@option.DefaultDurationMinutes"
                                            data-rate="@option.HourlyRate.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                            selected="@(Model.StudentSubjectId == option.StudentSubjectId)">
                                        @option.DisplayText
                                    </option>
                                }
                            </select>
                            <span asp-validation-for="StudentSubjectId" class="text-danger small"></span>
                            <div class="form-text small">
                                Öğrenciye farklı bir ders türü eklemek için <a asp-controller="Students" asp-action="Index">Öğrenciler</a> sayfasından "Dersler &amp; Ücretler" ekranını kullanabilirsiniz.
                            </div>
                        </div>

                        <div class="col-12 col-sm-6">
                            <label asp-for="LessonDate" class="form-label fw-semibold"></label>
                            <input type="date"
                                   id="LessonDate"
                                   name="LessonDate"
                                   value="@Model.LessonDate.ToString("yyyy-MM-dd")"
                                   class="form-control" />
                            <span asp-validation-for="LessonDate" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-sm-6">
                            <label asp-for="StartTime" class="form-label fw-semibold"></label>
                            <input type="time"
                                   id="StartTime"
                                   name="StartTime"
                                   value="@Model.StartTime.ToString("HH:mm")"
                                   class="form-control" />
                            <span asp-validation-for="StartTime" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-sm-6">
                            <label asp-for="DurationMinutes" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <input asp-for="DurationMinutes"
                                       id="durationMinutesInput"
                                       type="number"
                                       step="15"
                                       min="15"
                                       max="360"
                                       class="form-control" />
                                <span class="input-group-text">dakika</span>
                            </div>
                            <span asp-validation-for="DurationMinutes" class="text-danger small"></span>
                            <div class="form-text small">
                                Seçilen dersin varsayılan oturum süresi otomatik doldurulur; bu oturum için değiştirebilirsiniz.
                            </div>
                        </div>

                        <div class="col-12 col-sm-6">
                            <label class="form-label fw-semibold">Oturum Ücreti Önizlemesi</label>
                            <div class="p-2 px-3 rounded-3 bg-light border d-flex flex-column justify-content-center" style="min-height: 38px;">
                                <div id="feePreviewText" class="fw-bold text-primary">—</div>
                                <div class="small text-muted">Kayıt anında snapshot olarak dondurulur</div>
                            </div>
                        </div>

                        <div class="col-12">
                            <label asp-for="Notes" class="form-label fw-semibold"></label>
                            <textarea asp-for="Notes"
                                      rows="2"
                                      maxlength="1000"
                                      class="form-control"
                                      placeholder="Bu ders oturumunda işlenecek konu veya hatırlatma..."></textarea>
                            <span asp-validation-for="Notes" class="text-danger small"></span>
                        </div>

                        <div class="col-12 mt-4 d-flex justify-content-end gap-2">
                            <a class="btn btn-outline-secondary odys-touch-target px-4"
                               asp-controller="Schedule"
                               asp-action="Index"
                               asp-route-date="@Model.LessonDate.ToString("yyyy-MM-dd")">
                                İptal
                            </a>
                            <button type="submit" class="btn btn-primary odys-touch-target px-4 fw-semibold">
                                Dersi Takvime Kaydet
                            </button>
                        </div>
                    </div>
                </form>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const selectEl = document.getElementById('studentSubjectSelect');
            const durationEl = document.getElementById('durationMinutesInput');
            const previewEl = document.getElementById('feePreviewText');
            if (!selectEl || !durationEl || !previewEl) return;

            function updatePreview(syncDefaultDuration) {
                const selectedOpt = selectEl.options[selectEl.selectedIndex];
                if (!selectedOpt) return;

                const defaultDuration = parseInt(selectedOpt.getAttribute('data-duration') || '60', 10);
                const hourlyRate = parseFloat(selectedOpt.getAttribute('data-rate') || '0');

                if (syncDefaultDuration && defaultDuration >= 15) {
                    durationEl.value = defaultDuration;
                }

                const currentDuration = parseInt(durationEl.value || '0', 10);
                if (hourlyRate > 0 && currentDuration > 0) {
                    const sessionFee = (hourlyRate * currentDuration / 60.0);
                    previewEl.textContent = sessionFee.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ₺';
                } else {
                    previewEl.textContent = '—';
                }
            }

            selectEl.addEventListener('change', function () {
                updatePreview(true);
            });
            durationEl.addEventListener('input', function () {
                updatePreview(false);
            });

            updatePreview(false);
        })();
    </script>
}
