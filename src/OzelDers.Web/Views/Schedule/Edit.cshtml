@model EditLessonViewModel
@{
    ViewData["Title"] = "Ders Oturumunu Düzenle / Taşı";
}

<div class="row justify-content-center py-3">
    <div class="col-12 col-md-9 col-lg-7 col-xl-6">
        <div class="odys-card p-4">
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2 mb-4 border-bottom pb-3">
                <div>
                    <span class="odys-status-pill odys-status-active mb-2">Ders Düzenleme &amp; Gün/Saat Taşıma</span>
                    <h1 class="h4 fw-bold mb-1">Ders Oturumunu Düzenle</h1>
                    <p class="small text-muted mb-0">
                        Dersi başka bir güne veya saate taşıyabilir, oturum süresini, öğrenci–ders türünü veya notunu güncelleyebilirsiniz.
                    </p>
                </div>
                <a class="btn btn-outline-secondary btn-sm odys-touch-target px-3"
                   asp-controller="Schedule"
                   asp-action="Index"
                   asp-route-date="@Model.LessonDate.ToString("yyyy-MM-dd")">
                    ← Haftalık Takvim
                </a>
            </div>

            <form asp-controller="Schedule" asp-action="Edit" asp-route-id="@Model.Id" method="post" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="StudentSubjectId" class="form-label fw-semibold"></label>
                        <select asp-for="StudentSubjectId" id="editStudentSubjectSelect" class="form-select">
                            @foreach (var option in Model.AvailableEnrollments)
                            {
                                <option value="@option.StudentSubjectId"
                                        data-rate="@option.HourlyRate.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                        selected="@(Model.StudentSubjectId == option.StudentSubjectId)">
                                    @option.DisplayText
                                </option>
                            }
                        </select>
                        <span asp-validation-for="StudentSubjectId" class="text-danger small"></span>
                        <div class="form-text small">
                            Aynı öğrenci–ders türü korunduğunda dersin dondurulmuş saatlik ücreti (@Model.HourlyRateSnapshot.ToString("N2") ₺/sa) korunur.
                        </div>
                    </div>

                    <div class="col-12 col-sm-6">
                        <label asp-for="LessonDate" class="form-label fw-semibold"></label>
                        <input type="date"
                               id="LessonDate"
                               name="LessonDate"
                               value="@Model.LessonDate.ToString("yyyy-MM-dd")"
                               class="form-control" />
                        <span asp-validation-for="LessonDate" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-sm-6">
                        <label asp-for="StartTime" class="form-label fw-semibold"></label>
                        <input type="time"
                               id="StartTime"
                               name="StartTime"
                               value="@Model.StartTime.ToString("HH:mm")"
                               class="form-control" />
                        <span asp-validation-for="StartTime" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-sm-6">
                        <label asp-for="DurationMinutes" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <input asp-for="DurationMinutes"
                                   id="editDurationMinutesInput"
                                   type="number"
                                   step="15"
                                   min="15"
                                   max="360"
                                   class="form-control" />
                            <span class="input-group-text">dakika</span>
                        </div>
                        <span asp-validation-for="DurationMinutes" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-sm-6">
                        <label class="form-label fw-semibold">Oturum Ücreti (Snapshot)</label>
                        <div class="p-2 px-3 rounded-3 bg-light border d-flex flex-column justify-content-center" style="min-height: 38px;">
                            <div id="editFeePreviewText"
                                 data-initial-subject-id="@Model.StudentSubjectId"
                                 data-snapshot-rate="@Model.HourlyRateSnapshot.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                 class="fw-bold text-primary">
                                @Model.SessionFeeSnapshot.ToString("N2") ₺
                            </div>
                            <div class="small text-muted">Saatlik snapshot: @Model.HourlyRateSnapshot.ToString("N2") ₺</div>
                        </div>
                    </div>

                    <div class="col-12">
                        <label asp-for="Notes" class="form-label fw-semibold"></label>
                        <textarea asp-for="Notes"
                                  rows="2"
                                  maxlength="1000"
                                  class="form-control"
                                  placeholder="Ders konusu veya oturum notu..."></textarea>
                        <span asp-validation-for="Notes" class="text-danger small"></span>
                    </div>

                    <div class="col-12 mt-4 d-flex justify-content-end gap-2">
                        <a class="btn btn-outline-secondary odys-touch-target px-4"
                           asp-controller="Schedule"
                           asp-action="Index"
                           asp-route-date="@Model.LessonDate.ToString("yyyy-MM-dd")">
                            İptal
                        </a>
                        <button type="submit" class="btn btn-primary odys-touch-target px-4 fw-semibold">
                            Değişiklikleri Kaydet
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const selectEl = document.getElementById('editStudentSubjectSelect');
            const durationEl = document.getElementById('editDurationMinutesInput');
            const previewEl = document.getElementById('editFeePreviewText');
            if (!selectEl || !durationEl || !previewEl) return;

            const initialSubjectId = previewEl.getAttribute('data-initial-subject-id');
            const snapshotRate = parseFloat(previewEl.getAttribute('data-snapshot-rate') || '0');

            function updateEditPreview() {
                const selectedOpt = selectEl.options[selectEl.selectedIndex];
                if (!selectedOpt) return;

                const isSameSubject = (selectedOpt.value === initialSubjectId);
                const activeRate = isSameSubject
                    ? snapshotRate
                    : parseFloat(selectedOpt.getAttribute('data-rate') || '0');

                const currentDuration = parseInt(durationEl.value || '0', 10);
                if (activeRate > 0 && currentDuration > 0) {
                    const sessionFee = (activeRate * currentDuration / 60.0);
                    previewEl.textContent = sessionFee.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ₺';
                }
            }

            selectEl.addEventListener('change', updateEditPreview);
            durationEl.addEventListener('input', updateEditPreview);
        })();
    </script>
}
