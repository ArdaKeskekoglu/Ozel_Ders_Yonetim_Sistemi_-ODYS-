@model string
<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
     stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" focusable="false" aria-hidden="true">
    @if (Model == "dashboard")
    {
        <path d="M3 10.5 12 3l9 7.5V21h-6v-6H9v6H3z" />
    }
    else if (Model == "students")
    {
        <circle cx="9" cy="8" r="3" />
        <path d="M3 20v-2a6 6 0 0 1 12 0v2zM17 5a3 3 0 0 1 0 6M17 14a5 5 0 0 1 4 5v1" />
    }
    else if (Model == "schedule")
    {
        <rect x="3" y="5" width="18" height="16" rx="2" />
        <path d="M7 3v4M17 3v4M3 10h18M8 15h3M14 15h3" />
    }
    else if (Model == "profile")
    {
        <circle cx="12" cy="8" r="4" />
        <path d="M4 21a8 8 0 0 1 16 0" />
    }
    else if (Model == "lessons")
    {
        <circle cx="12" cy="12" r="9" />
        <path d="M12 7v5l3 2" />
    }
    else if (Model == "payments")
    {
        <rect x="2" y="5" width="20" height="14" rx="2" />
        <path d="M2 10h20M6 15h4" />
    }
    else if (Model == "reports")
    {
        <path d="M4 20V4M4 20h17M8 16v-5M13 16V7M18 16v-8" />
    }
    else if (Model == "notifications")
    {
        <path d="M18 8a6 6 0 0 0-12 0c0 7-3 8-3 9h18c0-1-3-2-3-9M10 21h4" />
    }
    else if (Model == "settings")
    {
        <circle cx="12" cy="12" r="3" />
        <path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9 7 7M17 17l2.1 2.1M19.1 4.9 17 7M7 17l-2.1 2.1" />
    }
</svg>
