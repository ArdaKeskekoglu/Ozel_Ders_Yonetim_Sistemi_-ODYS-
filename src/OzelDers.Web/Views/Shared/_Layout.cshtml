@inject INavigationService NavigationService
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Home";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
    var sidebarItems = NavigationService.GetSidebarItems(currentController, currentAction);
    var topbarItems = NavigationService.GetTopbarItems(currentController, currentAction);
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ÖDYS</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/OzelDers.Web.styles.css" asp-append-version="true" />
</head>
<body class="odys-body">
    <div class="odys-shell">
        <!-- Masaüstü Sol Menü (Sidebar) -->
        <aside class="odys-sidebar d-none d-lg-flex flex-column" aria-label="Ana Yan Menü">
            <div class="odys-sidebar-brand">
                <a class="odys-brand-link" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="odys-brand-badge">ÖDYS</span>
                    <span class="odys-brand-text">Özel Ders Yönetimi</span>
                </a>
            </div>
            <nav class="odys-sidebar-nav flex-grow-1" aria-label="Modül Navigasyonu">
                <ul class="nav flex-column gap-1">
                    @foreach (var item in sidebarItems)
                    {
                        <li class="nav-item">
                            <a class="nav-link odys-nav-link @(item.IsActive ? "active" : "")"
                               asp-area=""
                               asp-controller="@item.Controller"
                               asp-action="@item.Action"
                               aria-current="@(item.IsActive ? "page" : null)">
                                <span class="odys-nav-icon" aria-hidden="true">@item.IconText</span>
                                <span>@item.Title</span>
                            </a>
                        </li>
                    }
                </ul>
            </nav>
            <div class="odys-sidebar-footer">
                <span class="odys-status-pill odys-status-active">Sistem Hazır</span>
            </div>
        </aside>

        <!-- Sağ Ana Alan (Üst Bar + İçerik + Alt Bilgi) -->
        <div class="odys-main-wrapper d-flex flex-column flex-grow-1">
            <header class="odys-topbar border-bottom bg-white">
                <div class="container-fluid d-flex align-items-center justify-content-between py-2 px-3">
                    <div class="d-flex align-items-center gap-2">
                        <!-- Mobil Menü Açma Butonu -->
                        <button class="btn btn-outline-secondary d-lg-none odys-touch-target"
                                type="button"
                                data-bs-toggle="offcanvas"
                                data-bs-target="#odysMobileNav"
                                aria-controls="odysMobileNav"
                                aria-label="Ana Menüyü Aç">
                            ☰ Menü
                        </button>
                        <a class="navbar-brand fw-bold d-lg-none mb-0" asp-area="" asp-controller="Home" asp-action="Index">
                            ÖDYS
                        </a>
                        <span class="text-muted small d-none d-md-inline">
                            @ViewData["Title"]
                        </span>
                    </div>

                    <!-- Sağ Üst Aksiyonlar: Bildirimler, Profil, Ayarlar ve Hesap -->
                    <nav aria-label="Kullanıcı ve Ayarlar Menüsü">
                        <ul class="nav align-items-center gap-1">
                            @foreach (var topItem in topbarItems)
                            {
                                <li class="nav-item">
                                    <a class="nav-link odys-topbar-link odys-touch-target @(topItem.IsActive ? "active" : "")"
                                       asp-area=""
                                       asp-controller="@topItem.Controller"
                                       asp-action="@topItem.Action"
                                       aria-current="@(topItem.IsActive ? "page" : null)">
                                        <span aria-hidden="true">@topItem.IconText</span>
                                        <span class="d-none d-sm-inline ms-1">@topItem.Title</span>
                                    </a>
                                </li>
                            }
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <li class="nav-item ms-1">
                                    <span class="odys-status-pill odys-status-active">@User.Identity.Name</span>
                                </li>
                                <li class="nav-item ms-1">
                                    <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-secondary btn-sm odys-touch-target px-3">
                                            Çıkış Yap
                                        </button>
                                    </form>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item ms-1">
                                    <a class="btn btn-outline-primary btn-sm odys-touch-target px-3 fw-semibold"
                                       asp-area=""
                                       asp-controller="Account"
                                       asp-action="Login">
                                        Giriş Yap
                                    </a>
                                </li>
                                <li class="nav-item ms-1">
                                    <a class="btn btn-primary btn-sm odys-touch-target px-3 fw-semibold"
                                       asp-area=""
                                       asp-controller="Account"
                                       asp-action="Register">
                                        Kayıt Ol
                                    </a>
                                </li>
                            }
                        </ul>
                    </nav>
                </div>
            </header>

            <!-- Mobil Açılır Yan Menü (Offcanvas) -->
            <div class="offcanvas offcanvas-start d-lg-none"
                 tabindex="-1"
                 id="odysMobileNav"
                 aria-labelledby="odysMobileNavLabel">
                <div class="offcanvas-header border-bottom">
                    <h5 class="offcanvas-title fw-bold" id="odysMobileNavLabel">ÖDYS Menü</h5>
                    <button type="button" class="btn-close odys-touch-target" data-bs-dismiss="offcanvas" aria-label="Kapat"></button>
                </div>
                <div class="offcanvas-body d-flex flex-column justify-content-between">
                    <nav aria-label="Mobil Modül Navigasyonu">
                        <ul class="nav flex-column gap-2">
                            @foreach (var item in sidebarItems)
                            {
                                <li class="nav-item">
                                    <a class="nav-link odys-nav-link odys-touch-target @(item.IsActive ? "active" : "")"
                                       asp-area=""
                                       asp-controller="@item.Controller"
                                       asp-action="@item.Action"
                                       aria-current="@(item.IsActive ? "page" : null)">
                                        <span class="odys-nav-icon" aria-hidden="true">@item.IconText</span>
                                        <span>@item.Title</span>
                                    </a>
                                </li>
                            }
                        </ul>
                    </nav>
                    <div class="border-top pt-3 mt-3">
                        <div class="small text-muted mb-2">Hesap ve Tercihler</div>
                        <ul class="nav flex-column gap-1">
                            @foreach (var topItem in topbarItems)
                            {
                                <li class="nav-item">
                                    <a class="nav-link odys-nav-link odys-touch-target @(topItem.IsActive ? "active" : "")"
                                       asp-area=""
                                       asp-controller="@topItem.Controller"
                                       asp-action="@topItem.Action">
                                        <span class="odys-nav-icon" aria-hidden="true">@topItem.IconText</span>
                                        <span>@topItem.Title</span>
                                    </a>
                                </li>
                            }
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <li class="nav-item mt-2">
                                    <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger w-100 odys-touch-target justify-content-center fw-semibold">
                                            Çıkış Yap
                                        </button>
                                    </form>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item mt-2">
                                    <a class="btn btn-outline-primary w-100 odys-touch-target justify-content-center fw-semibold mb-2"
                                       asp-area=""
                                       asp-controller="Account"
                                       asp-action="Login">
                                        Giriş Yap
                                    </a>
                                    <a class="btn btn-primary w-100 odys-touch-target justify-content-center fw-semibold"
                                       asp-area=""
                                       asp-controller="Account"
                                       asp-action="Register">
                                        Yeni Öğretmen Kaydı
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Ana Sayfa İçeriği -->
            <main role="main" class="odys-content flex-grow-1 p-3 p-md-4">
                <div class="container-fluid">
                    @if (TempData["SuccessMessage"] is string successMessage)
                    {
                        <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
                            @successMessage
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
                        </div>
                    }
                    @RenderBody()
                </div>
            </main>

            <footer class="odys-footer border-top text-muted py-3 px-3 bg-white">
                <div class="container-fluid d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2 small">
                    <span>&copy; 2026 — Özel Ders Yönetim Sistemi (ÖDYS)</span>
                    <a class="text-decoration-none" asp-area="" asp-controller="Home" asp-action="Privacy">Gizlilik ve Veri Güvenliği</a>
                </div>
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
