@model KeyValuePair<string, string>
@{
    var panelId = $"odys-info-{Guid.NewGuid():N}";
}
<span class="odys-info">
    <button type="button"
            class="odys-info-toggle"
            aria-label="@Model.Key hakkında bilgi"
            aria-controls="@panelId"
            aria-expanded="false"
            data-odys-info-toggle>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
            <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2" />
            <path d="M12 10.5v5.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
            <circle cx="12" cy="7.5" r="1" fill="currentColor" />
        </svg>
    </button>
    <span id="@panelId" class="odys-info-panel" role="note" hidden>
        @Model.Value
        <button type="button" class="odys-info-close" aria-label="Açıklamayı kapat" data-odys-info-close>×</button>
    </span>
</span>
