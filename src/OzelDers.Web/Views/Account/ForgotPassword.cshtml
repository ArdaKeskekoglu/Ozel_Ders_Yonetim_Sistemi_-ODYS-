@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Şifremi Unuttum";
    var requestSubmitted = ViewData["RequestSubmitted"] as bool? == true;
    var devResetLink = ViewData["DevResetLink"] as string;
}

<div class="row justify-content-center py-3">
    <div class="col-12 col-md-8 col-lg-6 col-xl-5">
        <div class="odys-card p-4">
            <div class="mb-4">
                <span class="odys-status-pill odys-status-active mb-2">Şifre Kurtarma</span>
                <h1 class="h4 fw-bold mb-1">Şifremi Unuttum</h1>
                <p class="small text-muted mb-0">
                    Kayıtlı e-posta adresinizi girerek güvenli şifre sıfırlama bağlantısı talep edebilirsiniz.
                </p>
            </div>

            @if (requestSubmitted)
            {
                <div class="alert alert-info small" role="status">
                    Eğer girdiğiniz e-posta adresi sistemde kayıtlıysa, şifre sıfırlama yönergeleri oluşturulmuştur.
                </div>

                @if (!string.IsNullOrWhiteSpace(devResetLink))
                {
                    <div class="alert alert-warning small">
                        <div class="fw-semibold mb-1">Geliştirme Ortamı Doğrulama Bağlantısı:</div>
                        <a href="@devResetLink" class="fw-semibold text-break">Şifreyi Şimdi Sıfırla</a>
                    </div>
                }
            }

            <form asp-controller="Account" asp-action="ForgotPassword" method="post" novalidate>
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <input asp-for="Email" class="form-control" autocomplete="email" placeholder="ornek@eposta.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="col-12 mt-3">
                        <button type="submit" class="btn btn-primary w-100 odys-touch-target justify-content-center fw-semibold">
                            Sıfırlama Bağlantısı Oluştur
                        </button>
                    </div>
                </div>
            </form>

            <div class="border-top mt-4 pt-3 text-center small">
                <a class="fw-semibold text-decoration-none" asp-controller="Account" asp-action="Login">
                    Giriş Sayfasına Dön
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
