@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Yeni Şifre Belirle";
}

<div class="row justify-content-center py-3">
    <div class="col-12 col-md-8 col-lg-6 col-xl-5">
        <div class="odys-card p-4">
            <div class="mb-4">
                <span class="odys-status-pill odys-status-active mb-2">Şifre Sıfırlama</span>
                <h1 class="h4 fw-bold mb-1">Yeni Şifre Belirle</h1>
                <p class="small text-muted mb-0">
                    Hesabınız için güvenli yeni bir şifre belirleyin.
                </p>
            </div>

            <form asp-controller="Account" asp-action="ResetPassword" method="post" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Token" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <input asp-for="Email" class="form-control bg-light" readonly />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="NewPassword" class="form-label fw-semibold"></label>
                        <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                        <div class="form-text small">En az 8 karakter; büyük harf, küçük harf ve rakam içermelidir.</div>
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="ConfirmNewPassword" class="form-label fw-semibold"></label>
                        <input asp-for="ConfirmNewPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
                    </div>

                    <div class="col-12 mt-4">
                        <button type="submit" class="btn btn-primary w-100 odys-touch-target justify-content-center fw-semibold">
                            Şifremi Sıfırla
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
