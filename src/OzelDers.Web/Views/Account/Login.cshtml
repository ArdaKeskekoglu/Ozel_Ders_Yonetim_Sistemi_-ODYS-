@model LoginViewModel
@{
    ViewData["Title"] = "Öğretmen Girişi";
}

<div class="row justify-content-center py-3">
    <div class="col-12 col-md-8 col-lg-6 col-xl-5">
        <div class="odys-card p-4">
            <div class="mb-4">
                <span class="odys-status-pill odys-status-active mb-2">Öğretmen Oturumu</span>
                <h1 class="h4 fw-bold mb-1">Sisteme Giriş Yap</h1>
                <p class="small text-muted mb-0">
                    Kayıtlı e-posta adresiniz ve şifrenizle Özel Ders Yönetim Sistemi hesabınıza giriş yapın.
                </p>
            </div>

            <form asp-controller="Account" asp-action="Login" method="post" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ReturnUrl" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <input asp-for="Email" class="form-control" autocomplete="email" placeholder="ornek@eposta.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Password" class="form-label fw-semibold"></label>
                        <input asp-for="Password" class="form-control" autocomplete="current-password" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="col-12 d-flex justify-content-between align-items-center">
                        <div class="form-check">
                            <input asp-for="RememberMe" class="form-check-input" />
                            <label asp-for="RememberMe" class="form-check-label small"></label>
                        </div>
                        <a class="small text-decoration-none fw-semibold" asp-controller="Account" asp-action="ForgotPassword">
                            Şifremi Unuttum
                        </a>
                    </div>

                    <div class="col-12 mt-3">
                        <button type="submit" class="btn btn-primary w-100 odys-touch-target justify-content-center fw-semibold">
                            Giriş Yap
                        </button>
                    </div>
                </div>
            </form>

            <div class="border-top mt-4 pt-3 text-center small">
                <span class="text-muted">Henüz öğretmen hesabınız yok mu?</span>
                <a class="fw-semibold text-decoration-none ms-1" asp-controller="Account" asp-action="Register">
                    Kayıt Olun
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
