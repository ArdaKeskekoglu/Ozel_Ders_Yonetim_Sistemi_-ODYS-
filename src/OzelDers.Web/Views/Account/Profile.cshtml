@model ProfileViewModel
@{
    ViewData["Title"] = "Öğretmen Profili";
}

<div class="row justify-content-center py-3">
    <div class="col-12 col-lg-8 col-xl-7">
        <div class="odys-card p-4">
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2 mb-4 border-bottom pb-3">
                <div>
                    <span class="odys-status-pill odys-status-active mb-2">Hesap ve Tercihler</span>
                    <h1 class="h4 fw-bold mb-1">Profil Bilgilerim</h1>
                    <p class="small text-muted mb-0">
                        Ad, soyad, iletişim, saat dilimi ve varsayılan ders bilgilerinizi görüntüleyebilirsiniz.
                    </p>
                </div>
                <a class="btn btn-outline-primary btn-sm odys-touch-target px-3 fw-semibold"
                   asp-controller="Account"
                   asp-action="ChangePassword">
                    Şifre Değiştir
                </a>
            </div>

            <!-- Varsayılan Ders Türü Bilgisi -->
            <div class="p-3 rounded-3 border bg-light-subtle mb-4">
                <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2">
                    <div>
                        <div class="small text-muted fw-semibold">Varsayılan Ders Türünüz</div>
                        @if (!string.IsNullOrWhiteSpace(Model.DefaultSubjectName))
                        {
                            <div class="d-flex flex-wrap align-items-center gap-2 mt-1">
                                <span class="odys-status-pill odys-status-active">
                                    ★ @Model.DefaultSubjectName (Varsayılan)
                                </span>
                                @foreach (var subject in Model.ActiveSubjectNames.Where(s => !string.Equals(s, Model.DefaultSubjectName, StringComparison.OrdinalIgnoreCase)))
                                {
                                    <span class="badge bg-secondary-subtle text-secondary-emphasis rounded-pill px-3 py-1">
                                        @subject
                                    </span>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-warning-emphasis small mt-1">
                                Henüz tanımlı bir ders türünüz bulunmuyor. Öğrencilerinize ders atayabilmek için aşağıdan ilk (varsayılan) ders türünüzü tanımlayabilirsiniz.
                            </div>
                        }
                    </div>
                    <a class="btn btn-outline-secondary btn-sm odys-touch-target px-3 fw-semibold"
                       asp-controller="Subjects"
                       asp-action="Index">
                        Ders Türlerini Yönet
                    </a>
                </div>
            </div>

            <form asp-controller="Account" asp-action="Profile" method="post" novalidate>
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                <div class="row g-3">
                    <div class="col-12 col-sm-6">
                        <label asp-for="FirstName" class="form-label fw-semibold"></label>
                        <input asp-for="FirstName" class="form-control" />
                        <span asp-validation-for="FirstName" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-sm-6">
                        <label asp-for="LastName" class="form-label fw-semibold"></label>
                        <input asp-for="LastName" class="form-control" />
                        <span asp-validation-for="LastName" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="DisplayName" class="form-label fw-semibold"></label>
                        <input asp-for="DisplayName" class="form-control" placeholder="Boş bırakılırsa Ad Soyad kullanılır" />
                        <span asp-validation-for="DisplayName" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-sm-6">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <input asp-for="Email" class="form-control bg-light" readonly />
                        <div class="form-text small">Giriş e-posta adresiniz sabittir.</div>
                    </div>

                    <div class="col-12 col-sm-6">
                        <label asp-for="PhoneNumber" class="form-label fw-semibold"></label>
                        <input asp-for="PhoneNumber" class="form-control" placeholder="05xx xxx xx xx" />
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-sm-6">
                        <label asp-for="TimeZoneId" class="form-label fw-semibold"></label>
                        <select asp-for="TimeZoneId" class="form-select">
                            <option value="Turkey Standard Time">Türkiye Saati (UTC+03:00)</option>
                            <option value="UTC">UTC (Eşgüdümlü Evrensel Zaman)</option>
                            <option value="Central European Standard Time">Orta Avrupa Saati (CET)</option>
                            <option value="GMT Standard Time">Birleşik Krallık Saati (GMT/BST)</option>
                        </select>
                        <span asp-validation-for="TimeZoneId" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-sm-6">
                        <label asp-for="CurrencyCode" class="form-label fw-semibold"></label>
                        <input asp-for="CurrencyCode" class="form-control bg-light" readonly />
                    </div>

                    @if (!Model.HasAnyActiveSubject)
                    {
                        <div class="col-12">
                            <div class="p-3 rounded-3 border border-warning bg-warning-subtle">
                                <label asp-for="InitialSubjectName" class="form-label fw-semibold"></label>
                                <input asp-for="InitialSubjectName" class="form-control" placeholder="Örn. Matematik" />
                                <div class="form-text small">Tanımladığınız bu ilk ders otomatik olarak varsayılan dersiniz olacaktır.</div>
                                <span asp-validation-for="InitialSubjectName" class="text-danger small"></span>
                            </div>
                        </div>
                    }

                    <div class="col-12 mt-4 d-flex justify-content-end">
                        <button type="submit" class="btn btn-primary odys-touch-target px-4 fw-semibold">
                            Değişiklikleri Kaydet
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
