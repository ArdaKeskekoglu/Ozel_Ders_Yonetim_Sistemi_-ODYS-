@model RegisterViewModel
@{
    ViewData["Title"] = "Öğretmen Kaydı";
}

<div class="row justify-content-center py-3">
    <div class="col-12 col-md-8 col-lg-6 col-xl-5">
        <div class="odys-card p-4">
            <div class="mb-4">
                <span class="odys-status-pill odys-status-active mb-2">Öğretmen Hesabı</span>
                <h1 class="h4 fw-bold mb-1">Yeni Öğretmen Kaydı</h1>
                <p class="small text-muted mb-0">
                    Öğrencilerinizi, haftalık ders programınızı ve tahsilatlarınızı yönetmek için öğretmen hesabınızı oluşturun.
                </p>
            </div>

            <form asp-controller="Account" asp-action="Register" method="post" novalidate>
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                <div class="row g-3">
                    <div class="col-12 col-sm-6">
                        <label asp-for="FirstName" class="form-label fw-semibold"></label>
                        <input asp-for="FirstName" class="form-control" autocomplete="given-name" placeholder="Örn. Ayşe" />
                        <span asp-validation-for="FirstName" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-sm-6">
                        <label asp-for="LastName" class="form-label fw-semibold"></label>
                        <input asp-for="LastName" class="form-control" autocomplete="family-name" placeholder="Örn. Yılmaz" />
                        <span asp-validation-for="LastName" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <input asp-for="Email" class="form-control" autocomplete="email" placeholder="ornek@eposta.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="PhoneNumber" class="form-label fw-semibold"></label>
                        <input asp-for="PhoneNumber" class="form-control" autocomplete="tel" placeholder="05xx xxx xx xx" />
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Password" class="form-label fw-semibold"></label>
                        <input asp-for="Password" class="form-control" autocomplete="new-password" />
                        <div class="form-text small">En az 8 karakter; büyük harf, küçük harf ve rakam içermelidir.</div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="ConfirmPassword" class="form-label fw-semibold"></label>
                        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <div class="col-12 mt-4">
                        <button type="submit" class="btn btn-primary w-100 odys-touch-target justify-content-center fw-semibold">
                            Öğretmen Hesabı Oluştur
                        </button>
                    </div>
                </div>
            </form>

            <div class="border-top mt-4 pt-3 text-center small">
                <span class="text-muted">Zaten öğretmen hesabınız var mı?</span>
                <a class="fw-semibold text-decoration-none ms-1" asp-controller="Account" asp-action="Login">
                    Giriş Yapın
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
