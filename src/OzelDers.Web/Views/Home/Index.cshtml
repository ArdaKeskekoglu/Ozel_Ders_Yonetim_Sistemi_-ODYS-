@model HomeIndexViewModel
@{
    ViewData["Title"] = "Ana Sayfa";
}

<section class="odys-card p-4 mb-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
        <div>
            <span class="odys-status-pill odys-status-active mb-2">Altyapı ve Navigasyon Aktif</span>
            <h1 class="h3 fw-bold mb-2">@Model.FullTitle</h1>
            <p class="text-muted mb-0">@Model.Description</p>
        </div>
    </div>
</section>

<section aria-label="Temel Modül Özeti">
    <div class="row g-3">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="odys-card p-3 h-100">
                <div class="small text-muted fw-semibold">Öğrenci & Ders Türleri</div>
                <div class="h5 fw-bold mt-1 mb-2">Öğrenci Yönetimi</div>
                <p class="small text-muted mb-0">Öğrenci kartları, ders başına özel ücretler ve haftalık hedef ders sayıları.</p>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="odys-card p-3 h-100">
                <div class="small text-muted fw-semibold">Haftalık Takvim</div>
                <div class="h5 fw-bold mt-1 mb-2">Ders Programı</div>
                <p class="small text-muted mb-0">Manuel ders planlama, çakışma kontrolü ve tek haftalık otomatik programlama.</p>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="odys-card p-3 h-100">
                <div class="small text-muted fw-semibold">Yoklama & Ücret Kararı</div>
                <div class="h5 fw-bold mt-1 mb-2">Ders Geçmişi</div>
                <p class="small text-muted mb-0">Katılım kaydı ve devamsızlık durumunda ders bazlı ücret alınacak mı kararı.</p>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="odys-card p-3 h-100">
                <div class="small text-muted fw-semibold">Tahakkuk & Tahsilat</div>
                <div class="h5 fw-bold mt-1 mb-2">Ödemeler & Raporlar</div>
                <p class="small text-muted mb-0">Tam, kısmi ve toplu tahsilat dağılımı, açık alacak takibi ve dönemlik raporlar.</p>
            </div>
        </div>
    </div>
</section>
