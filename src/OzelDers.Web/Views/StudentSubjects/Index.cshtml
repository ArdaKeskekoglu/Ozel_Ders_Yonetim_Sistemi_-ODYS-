@model StudentSubjectsIndexViewModel
@{
    ViewData["Title"] = $"{Model.StudentFullName} — Ders Türleri ve Ücretler";
}

<section class="odys-card p-4 mb-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
        <div>
            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                <span class="odys-status-pill odys-status-active">Öğrenci Ders &amp; Ücret Yönetimi</span>
                @if (Model.IsStudentArchived)
                {
                    <span class="badge bg-secondary-subtle text-secondary-emphasis rounded-pill px-3 py-1">
                        Arşivlenmiş Öğrenci
                    </span>
                }
            </div>
            <h1 class="h4 fw-bold mb-1">@Model.StudentFullName — Ders Türleri ve Ücretleri</h1>
            <p class="small text-muted mb-0">
                Öğrencinin aldığı her ders türü için saatlik ücreti, tek oturum süresini ve haftalık hedef oturum adedini ayrı ayrı yönetebilirsiniz.
            </p>
        </div>

        <div class="d-flex flex-wrap align-items-center gap-2">
            <a class="btn btn-outline-secondary odys-touch-target px-3"
               asp-controller="Students"
               asp-action="Index">
                ← Öğrencilere Dön
            </a>
            <a class="btn btn-primary odys-touch-target px-3 fw-semibold"
               asp-controller="StudentSubjects"
               asp-action="Assign"
               asp-route-studentId="@Model.StudentId">
                + Yeni Ders Türü Ata
            </a>
        </div>
    </div>

    <hr class="my-3" />

    <!-- Özet Metrik Kartları -->
    <div class="row g-3">
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="p-3 rounded-3 bg-light border h-100">
                <div class="small text-muted">Aktif Ders Türü</div>
                <div class="h5 fw-bold mb-0">@Model.ActiveCount Ders</div>
                @if (Model.InactiveCount > 0)
                {
                    <div class="small text-muted mt-1">+@Model.InactiveCount pasif kayıt</div>
                }
            </div>
        </div>
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="p-3 rounded-3 bg-light border h-100">
                <div class="small text-muted">Haftalık Hedef Oturum</div>
                <div class="h5 fw-bold mb-0">@Model.TotalWeeklySessions Oturum / Hafta</div>
                <div class="small text-muted mt-1">Her oturum tek bir ders türüne aittir</div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="p-3 rounded-3 bg-light border h-100">
                <div class="small text-muted">Haftalık Toplam Süre</div>
                <div class="h5 fw-bold mb-0">@Model.TotalWeeklyMinutes Dakika</div>
                <div class="small text-muted mt-1">(@Math.Round(Model.TotalWeeklyMinutes / 60.0, 1) saat / hafta)</div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="p-3 rounded-3 bg-light border h-100">
                <div class="small text-muted">Haftalık Tahmini Tutar</div>
                <div class="h5 fw-bold text-primary mb-0">@Model.TotalEstimatedWeeklyFee.ToString("N2") ₺</div>
                @if (!string.IsNullOrWhiteSpace(Model.TeacherDefaultSubjectName))
                {
                    <div class="small text-muted mt-1">★ Varsayılan dersiniz: @Model.TeacherDefaultSubjectName</div>
                }
            </div>
        </div>
    </div>
</section>

@if (!Model.HasAnyAssignments)
{
    <section class="odys-card p-5 text-center" aria-label="Boş Öğrenci Ders Listesi">
        <div class="display-6 mb-3" aria-hidden="true">📚</div>
        <h2 class="h5 fw-bold mb-2">@Model.StudentFullName için henüz ders türü atanmadı</h2>
        <p class="text-muted small mx-auto mb-3" style="max-width: 520px;">
            Ders atama ekranını açtığınızda varsayılan dersiniz
            @if (!string.IsNullOrWhiteSpace(Model.TeacherDefaultSubjectName))
            {
                <strong>(@Model.TeacherDefaultSubjectName)</strong>
            }
            otomatik olarak seçili gelecektir. Dilerseniz öğrenciye birden fazla ders türü ve her ders için farklı saatlik ücret tanımlayabilirsiniz.
        </p>
        <a class="btn btn-primary odys-touch-target px-4 fw-semibold"
           asp-controller="StudentSubjects"
           asp-action="Assign"
           asp-route-studentId="@Model.StudentId">
            + İlk Ders Türünü Ata
        </a>
    </section>
}
else
{
    <section class="odys-card overflow-hidden mb-3" aria-label="Öğrenci Ders Türleri Tablosu">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col" class="ps-4">Ders Türü</th>
                        <th scope="col">Saatlik Ücret (60 dk)</th>
                        <th scope="col">Tek Oturum Süresi</th>
                        <th scope="col">Haftalık Hedef</th>
                        <th scope="col">Tek Oturum Ücreti</th>
                        <th scope="col">Haftalık Tahmini Ücret</th>
                        <th scope="col">Durum</th>
                        <th scope="col" class="text-end pe-4">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="fw-semibold">@item.SubjectName</div>
                                @if (item.IsTeacherDefaultSubject)
                                {
                                    <span class="badge bg-primary-subtle text-primary-emphasis rounded-pill small">
                                        ★ Varsayılan Dersiniz
                                    </span>
                                }
                                @if (item.IsSubjectArchived)
                                {
                                    <span class="badge bg-warning-subtle text-warning-emphasis rounded-pill small">
                                        Arşivli Ders Türü
                                    </span>
                                }
                            </td>
                            <td class="fw-semibold">@item.HourlyRate.ToString("N2") ₺</td>
                            <td>@item.DefaultDurationMinutes dk</td>
                            <td>
                                <span class="fw-semibold">@item.WeeklyTargetCount oturum</span>
                                <span class="text-muted small d-block">
                                    (@item.WeeklyTargetCount × @item.DefaultDurationMinutes dk = @item.WeeklyTotalMinutes dk)
                                </span>
                            </td>
                            <td>@item.EstimatedSessionFee.ToString("N2") ₺</td>
                            <td class="fw-semibold text-primary">@item.EstimatedWeeklyFee.ToString("N2") ₺</td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="odys-status-pill odys-status-active">Aktif</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary-emphasis rounded-pill px-3 py-1">
                                        Pasif
                                    </span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <div class="d-inline-flex flex-wrap align-items-center justify-content-end gap-2">
                                    <a class="btn btn-outline-primary btn-sm odys-touch-target px-3"
                                       asp-controller="StudentSubjects"
                                       asp-action="Edit"
                                       asp-route-id="@item.Id">
                                        Düzenle
                                    </a>

                                    @if (item.IsActive)
                                    {
                                        <form asp-controller="StudentSubjects"
                                              asp-action="Deactivate"
                                              asp-route-id="@item.Id"
                                              asp-route-studentId="@Model.StudentId"
                                              method="post"
                                              class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-secondary btn-sm odys-touch-target px-3">
                                                Pasife Al
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-controller="StudentSubjects"
                                              asp-action="Activate"
                                              asp-route-id="@item.Id"
                                              asp-route-studentId="@Model.StudentId"
                                              method="post"
                                              class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-success btn-sm odys-touch-target px-3">
                                                Aktifleştir
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <div class="alert alert-info small mb-0">
        <strong>İş Kuralı Bilgi Notu:</strong> Bir öğrenci aynı öğretmenden birden fazla ders türü (örn. Matematik ve Geometri) alabilir; ancak takvimde oluşturulan her bir ders oturumu yalnızca <strong>tek bir ders türüne</strong> bağlanır. Ücret veya varsayılan ders değişiklikleri geçmiş ders oturumlarını etkilemez.
    </div>
}
