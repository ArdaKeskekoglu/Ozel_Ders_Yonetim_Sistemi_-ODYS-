@model EditSubjectViewModel
@{
    ViewData["Title"] = "Ders Türünü Düzenle";
}

<div class="row justify-content-center py-3">
    <div class="col-12 col-md-8 col-lg-6 col-xl-5">
        <div class="odys-card p-4">
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2 mb-4 border-bottom pb-3">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="odys-status-pill odys-status-active">Ders Türü Yönetimi</span>
                        @if (Model.IsDefault && !Model.IsArchived)
                        {
                            <span class="odys-status-pill odys-status-active">★ Varsayılan</span>
                        }
                        @if (Model.IsArchived)
                        {
                            <span class="badge bg-secondary-subtle text-secondary-emphasis rounded-pill px-3 py-1">
                                Arşivde
                            </span>
                        }
                    </div>
                    <h1 class="h4 fw-bold mb-1">Ders Türünü Düzenle</h1>
                    <p class="small text-muted mb-0">
                        Ders türünün adını ve varsayılan durumunu güncelleyebilirsiniz.
                    </p>
                </div>
                <a class="btn btn-outline-secondary btn-sm odys-touch-target px-3"
                   asp-controller="Subjects"
                   asp-action="Index">
                    ← Ders Türleri
                </a>
            </div>

            <form asp-controller="Subjects" asp-action="Edit" asp-route-id="@Model.Id" method="post" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="IsArchived" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="Name" class="form-label fw-semibold"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    @if (!Model.IsArchived)
                    {
                        <div class="col-12">
                            @if (Model.IsDefault)
                            {
                                <input type="hidden" asp-for="IsDefault" />
                                <div class="small text-muted">
                                    Bu ders şu anda <strong>varsayılan dersinizdir</strong>. Varsayılan dersi değiştirmek için başka bir aktif dersi varsayılan olarak seçebilirsiniz.
                                </div>
                            }
                            else
                            {
                                <div class="form-check">
                                    <input asp-for="IsDefault" class="form-check-input" />
                                    <label asp-for="IsDefault" class="form-check-label small"></label>
                                </div>
                            }
                        </div>
                    }

                    <div class="col-12 mt-4 d-flex justify-content-end gap-2">
                        <a class="btn btn-outline-secondary odys-touch-target px-4"
                           asp-controller="Subjects"
                           asp-action="Index">
                            İptal
                        </a>
                        <button type="submit" class="btn btn-primary odys-touch-target px-4 fw-semibold">
                            Değişiklikleri Kaydet
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
