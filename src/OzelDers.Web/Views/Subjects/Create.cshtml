@model CreateSubjectViewModel
@{
    ViewData["Title"] = "Yeni Ders Türü Ekle";
}

<div class="row justify-content-center py-3">
    <div class="col-12 col-md-8 col-lg-6 col-xl-5">
        <div class="odys-card p-4">
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2 mb-4 border-bottom pb-3">
                <div>
                    <span class="odys-status-pill odys-status-active mb-2">Ders Türü Yönetimi</span>
                    <h1 class="h4 fw-bold mb-1">Yeni Ders Türü Ekle</h1>
                    <p class="small text-muted mb-0">
                        Öğrencilerinize atayabileceğiniz yeni bir ders türü tanımlayın.
                    </p>
                </div>
                <a class="btn btn-outline-secondary btn-sm odys-touch-target px-3"
                   asp-controller="Subjects"
                   asp-action="Index">
                    ← Ders Türleri
                </a>
            </div>

            <form asp-controller="Subjects" asp-action="Create" method="post" novalidate>
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="Name" class="form-label fw-semibold"></label>
                        <input asp-for="Name" class="form-control" placeholder="Örn. Matematik, Geometri, AYT Fizik..." />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <div class="form-check">
                            <input asp-for="SetAsDefault" class="form-check-input" />
                            <label asp-for="SetAsDefault" class="form-check-label small"></label>
                        </div>
                        <div class="form-text small">
                            Henüz aktif bir ders türünüz yoksa bu ders otomatik olarak varsayılan dersiniz olur.
                        </div>
                    </div>

                    <div class="col-12 mt-4 d-flex justify-content-end gap-2">
                        <a class="btn btn-outline-secondary odys-touch-target px-4"
                           asp-controller="Subjects"
                           asp-action="Index">
                            İptal
                        </a>
                        <button type="submit" class="btn btn-primary odys-touch-target px-4 fw-semibold">
                            Ders Türünü Kaydet
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
