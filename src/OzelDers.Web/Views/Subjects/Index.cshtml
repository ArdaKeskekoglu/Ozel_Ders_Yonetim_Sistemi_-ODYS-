@model SubjectListFilterViewModel
@{
    ViewData["Title"] = "Ders Türleri";
}

<section class="odys-card p-4 mb-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
        <div>
            <div class="d-flex align-items-center gap-1">
                <h1 class="h4 fw-bold mb-0">Ders Türlerim</h1>
                @await Html.PartialAsync("_InfoPopover", new KeyValuePair<string, string>(
                    "Ders Türleri",
                    "Varsayılan ders, öğrenciye ders türü atarken otomatik seçilir."))
            </div>
        </div>
        <div class="d-flex flex-wrap align-items-center gap-2">
            @if (!string.IsNullOrWhiteSpace(Model.DefaultSubjectName))
            {
                <span class="odys-status-pill odys-status-active">
                    ★ Varsayılan: @Model.DefaultSubjectName
                </span>
            }
            <span class="badge bg-primary-subtle text-primary-emphasis px-3 py-2">
                Aktif: @Model.ActiveCount
            </span>
            <span class="badge bg-secondary-subtle text-secondary-emphasis px-3 py-2">
                Arşiv: @Model.ArchivedCount
            </span>
            <a class="btn btn-primary odys-touch-target px-3 fw-semibold"
               asp-controller="Subjects"
               asp-action="Create">
                + Yeni Ders Türü Ekle
            </a>
        </div>
    </div>

    <hr class="my-3" />

    <!-- Durum Filtresi -->
    <form asp-controller="Subjects" asp-action="Index" method="get" class="row g-2 align-items-center">
        <div class="col-12 col-sm-6 col-md-4 col-lg-3">
            <label for="status" class="visually-hidden">Durum Filtresi</label>
            <select id="status" name="status" class="form-select">
                <option value="@SubjectStatusFilter.Active" selected="@(Model.Status == SubjectStatusFilter.Active)">
                    Aktif Ders Türleri (@Model.ActiveCount)
                </option>
                <option value="@SubjectStatusFilter.Archived" selected="@(Model.Status == SubjectStatusFilter.Archived)">
                    Arşivlenenler (@Model.ArchivedCount)
                </option>
                <option value="@SubjectStatusFilter.All" selected="@(Model.Status == SubjectStatusFilter.All)">
                    Tümü (@Model.TotalCount)
                </option>
            </select>
        </div>

        <div class="col-12 col-sm-6 col-md-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary odys-touch-target px-4 fw-semibold">
                Filtrele
            </button>
            @if (Model.Status != SubjectStatusFilter.Active)
            {
                <a class="btn btn-outline-secondary odys-touch-target px-3"
                   asp-controller="Subjects"
                   asp-action="Index">
                    Sıfırla
                </a>
            }
        </div>
    </form>
</section>

@if (!Model.HasAnySubjects)
{
    <section class="odys-card p-5 text-center" aria-label="Boş Ders Türü Listesi">
        <div class="display-6 mb-3" aria-hidden="true">📘</div>
        <h2 class="h5 fw-bold mb-2">Henüz tanımlı bir ders türünüz bulunmuyor</h2>
        <p class="text-muted small mx-auto mb-3" style="max-width: 480px;">
            İlk eklediğiniz ders türü otomatik olarak varsayılan dersiniz olarak belirlenecektir.
        </p>
        <a class="btn btn-primary odys-touch-target px-4 fw-semibold"
           asp-controller="Subjects"
           asp-action="Create">
            + İlk Ders Türünüzü Ekleyin
        </a>
    </section>
}
else if (!Model.HasFilteredResults)
{
    <section class="odys-card p-5 text-center" aria-label="Filtre Sonucu Bulunamadı">
        <h2 class="h5 fw-bold mb-2">Seçilen durumda ders türü bulunamadı</h2>
        <p class="text-muted small mb-3">
            Aktif ders türlerinizi görüntülemek için filtreyi sıfırlayabilirsiniz.
        </p>
        <a class="btn btn-outline-primary odys-touch-target px-4 fw-semibold"
           asp-controller="Subjects"
           asp-action="Index">
            Aktif Ders Türlerini Göster
        </a>
    </section>
}
else
{
    <section class="odys-card overflow-hidden" aria-label="Ders Türleri Tablosu">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col" class="ps-4">Ders Türü Adı</th>
                        <th scope="col">Varsayılan Durumu</th>
                        <th scope="col">Durum</th>
                        <th scope="col" class="text-end pe-4">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var subject in Model.Subjects)
                    {
                        <tr>
                            <td class="ps-4 fw-semibold">@subject.Name</td>
                            <td>
                                @if (subject.IsDefault && !subject.IsArchived)
                                {
                                    <span class="odys-status-pill odys-status-active">
                                        ★ Varsayılan Ders
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted small">Standart</span>
                                }
                            </td>
                            <td>
                                @if (subject.IsArchived)
                                {
                                    <span class="badge bg-secondary-subtle text-secondary-emphasis rounded-pill px-3 py-1">
                                        Arşivlendi
                                    </span>
                                }
                                else
                                {
                                    <span class="odys-status-pill odys-status-active">
                                        Aktif
                                    </span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <div class="d-inline-flex flex-wrap align-items-center justify-content-end gap-2">
                                    @if (!subject.IsArchived && !subject.IsDefault)
                                    {
                                        <form asp-controller="Subjects"
                                              asp-action="SetDefault"
                                              asp-route-id="@subject.Id"
                                              method="post"
                                              class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-success btn-sm odys-touch-target px-3">
                                                Varsayılan Yap
                                            </button>
                                        </form>
                                    }

                                    <a class="btn btn-outline-primary btn-sm odys-touch-target px-3"
                                       asp-controller="Subjects"
                                       asp-action="Edit"
                                       asp-route-id="@subject.Id">
                                        Düzenle
                                    </a>

                                    @if (subject.IsArchived)
                                    {
                                        <form asp-controller="Subjects"
                                              asp-action="Unarchive"
                                              asp-route-id="@subject.Id"
                                              method="post"
                                              class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-success btn-sm odys-touch-target px-3">
                                                Yeniden Aktif Et
                                            </button>
                                        </form>
                                    }
                                    else if (Model.CanArchiveActiveSubject)
                                    {
                                        <form asp-controller="Subjects"
                                              asp-action="Archive"
                                              asp-route-id="@subject.Id"
                                              method="post"
                                              class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-secondary btn-sm odys-touch-target px-3">
                                                Arşivle
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}
