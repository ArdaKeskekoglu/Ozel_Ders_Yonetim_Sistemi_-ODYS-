@model EditStudentViewModel
@{
    ViewData["Title"] = "Öğrenci Bilgilerini Düzenle";
}

<div class="row justify-content-center py-3">
    <div class="col-12 col-lg-8 col-xl-7">
        <div class="odys-card p-4">
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2 mb-4 border-bottom pb-3">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="odys-status-pill odys-status-active">Öğrenci Yönetimi</span>
                        @if (Model.IsArchived)
                        {
                            <span class="badge bg-secondary-subtle text-secondary-emphasis rounded-pill px-3 py-1">
                                Arşivde
                            </span>
                        }
                    </div>
                    <h1 class="h4 fw-bold mb-1">Öğrenci Bilgilerini Düzenle</h1>
                    <p class="small text-muted mb-0">
                        Öğrencinin ad, soyad, iletişim ve özel not bilgilerini güncelleyebilirsiniz.
                    </p>
                </div>
                <a class="btn btn-outline-secondary btn-sm odys-touch-target px-3"
                   asp-controller="Students"
                   asp-action="Index">
                    ← Öğrenci Listesi
                </a>
            </div>

            <form asp-controller="Students" asp-action="Edit" asp-route-id="@Model.Id" method="post" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="IsArchived" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                <div class="row g-3">
                    <div class="col-12 col-sm-6">
                        <label asp-for="FirstName" class="form-label fw-semibold"></label>
                        <input asp-for="FirstName" class="form-control" />
                        <span asp-validation-for="FirstName" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-sm-6">
                        <label asp-for="LastName" class="form-label fw-semibold"></label>
                        <input asp-for="LastName" class="form-control" />
                        <span asp-validation-for="LastName" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-sm-6">
                        <label asp-for="PhoneNumber" class="form-label fw-semibold"></label>
                        <input asp-for="PhoneNumber" class="form-control" placeholder="05xx xxx xx xx" />
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-sm-6">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <input asp-for="Email" class="form-control" placeholder="ogrenci@ornek.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Notes" class="form-label fw-semibold"></label>
                        <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Notes" class="text-danger small"></span>
                    </div>

                    <div class="col-12 mt-4 d-flex justify-content-end gap-2">
                        <a class="btn btn-outline-secondary odys-touch-target px-4"
                           asp-controller="Students"
                           asp-action="Index">
                            İptal
                        </a>
                        <button type="submit" class="btn btn-primary odys-touch-target px-4 fw-semibold">
                            Değişiklikleri Kaydet
                        </button>
                    </div>
                </div>
            </form>

            <div class="border-top mt-4 pt-3 d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2">
                <div class="small text-muted">
                    @if (Model.IsArchived)
                    {
                        <span>Bu öğrenci şu anda arşivde. Yeniden ders planlamak için aktif hâle getirebilirsiniz.</span>
                    }
                    else
                    {
                        <span>Öğrenciyi arşivlemek geçmiş ders ve ödeme kayıtlarını silmez.</span>
                    }
                </div>
                @if (Model.IsArchived)
                {
                    <form asp-controller="Students" asp-action="Unarchive" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-success btn-sm odys-touch-target px-3 fw-semibold">
                            Yeniden Aktif Et
                        </button>
                    </form>
                }
                else
                {
                    <form asp-controller="Students" asp-action="Archive" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-secondary btn-sm odys-touch-target px-3 fw-semibold">
                            Öğrenciyi Arşivle
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
