@model CreateStudentViewModel
@{
    ViewData["Title"] = "Yeni Öğrenci Ekle";
}

<div class="row justify-content-center py-3">
    <div class="col-12 col-lg-8 col-xl-7">
        <div class="odys-card p-4">
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2 mb-4 border-bottom pb-3">
                <div>
                    <span class="odys-status-pill odys-status-active mb-2">Öğrenci Yönetimi</span>
                    <h1 class="h4 fw-bold mb-1">Yeni Öğrenci Ekle</h1>
                    <p class="small text-muted mb-0">
                        Öğrencinin ad ve soyad bilgilerini girin. İletişim bilgileri ve özel notlar isteğe bağlıdır.
                    </p>
                </div>
                <a class="btn btn-outline-secondary btn-sm odys-touch-target px-3"
                   asp-controller="Students"
                   asp-action="Index">
                    ← Öğrenci Listesi
                </a>
            </div>

            <form asp-controller="Students" asp-action="Create" method="post" novalidate>
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                <div class="row g-3">
                    <div class="col-12 col-sm-6">
                        <label asp-for="FirstName" class="form-label fw-semibold"></label>
                        <input asp-for="FirstName" class="form-control" placeholder="Örn. Zeynep" />
                        <span asp-validation-for="FirstName" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-sm-6">
                        <label asp-for="LastName" class="form-label fw-semibold"></label>
                        <input asp-for="LastName" class="form-control" placeholder="Örn. Korkmaz" />
                        <span asp-validation-for="LastName" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-sm-6">
                        <label asp-for="PhoneNumber" class="form-label fw-semibold"></label>
                        <input asp-for="PhoneNumber" class="form-control" placeholder="05xx xxx xx xx" />
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-sm-6">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <input asp-for="Email" class="form-control" placeholder="ogrenci@ornek.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Notes" class="form-label fw-semibold"></label>
                        <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Öğrencinin seviyesi, hedef sınavı veya özel çalışma notları..."></textarea>
                        <span asp-validation-for="Notes" class="text-danger small"></span>
                    </div>

                    <div class="col-12 mt-4 d-flex justify-content-end gap-2">
                        <a class="btn btn-outline-secondary odys-touch-target px-4"
                           asp-controller="Students"
                           asp-action="Index">
                            İptal
                        </a>
                        <button type="submit" class="btn btn-primary odys-touch-target px-4 fw-semibold">
                            Öğrenciyi Kaydet
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
