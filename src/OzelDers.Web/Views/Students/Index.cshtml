@model StudentListFilterViewModel
@{
    ViewData["Title"] = "Öğrenciler";
}

<section class="odys-card odys-students-toolbar p-3 p-md-4 mb-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
        <div>
            <h1 class="h4 fw-bold mb-0">Öğrencilerim</h1>
        </div>
        <div class="d-flex flex-wrap align-items-center gap-2 odys-students-header-actions">
            <span class="odys-student-count odys-student-count-active">
                Aktif <strong>@Model.ActiveCount</strong>
            </span>
            <span class="odys-student-count">
                Arşiv <strong>@Model.ArchivedCount</strong>
            </span>
            @if (Model.HasAnyStudents)
            {
                <a class="btn btn-primary odys-touch-target px-3 fw-semibold odys-students-add"
                   asp-controller="Students"
                   asp-action="Create">
                    + Yeni Öğrenci
                </a>
            }
        </div>
    </div>

    <form asp-controller="Students" asp-action="Index" method="get" class="odys-students-filters mt-3 pt-3">
        <div class="odys-students-search">
            <label for="searchTerm" class="visually-hidden">Öğrenci Ara</label>
            <input type="search"
                   id="searchTerm"
                   name="searchTerm"
                   value="@Model.SearchTerm"
                   class="form-control"
                   placeholder="Öğrenci ara" />
        </div>

        <div class="odys-students-subject-filter">
            <label for="subjectId" class="visually-hidden">Ders Türü Filtresi</label>
            <select id="subjectId" name="subjectId" class="form-select">
                <option value="">Tüm Ders Türleri</option>
                @foreach (var subject in Model.AvailableSubjects)
                {
                    <option value="@subject.Id" selected="@(Model.SubjectId == subject.Id)">
                        @subject.Name
                    </option>
                }
            </select>
        </div>

        <div class="odys-students-status-filter">
            <label for="status" class="visually-hidden">Durum Filtresi</label>
            <select id="status" name="status" class="form-select">
                <option value="@StudentStatusFilter.Active" selected="@(Model.Status == StudentStatusFilter.Active)">
                    Aktif (@Model.ActiveCount)
                </option>
                <option value="@StudentStatusFilter.Archived" selected="@(Model.Status == StudentStatusFilter.Archived)">
                    Arşiv (@Model.ArchivedCount)
                </option>
                <option value="@StudentStatusFilter.All" selected="@(Model.Status == StudentStatusFilter.All)">
                    Tümü (@Model.TotalCount)
                </option>
            </select>
        </div>

        <div class="odys-students-filter-actions">
            <button type="submit" class="btn btn-primary odys-touch-target px-3 fw-semibold">
                Filtrele
            </button>
            @if (!string.IsNullOrWhiteSpace(Model.SearchTerm) || Model.Status != StudentStatusFilter.Active || Model.SubjectId.HasValue)
            {
                <a class="btn btn-outline-secondary odys-touch-target px-3"
                   asp-controller="Students"
                   asp-action="Index">
                    Sıfırla
                </a>
            }
        </div>
    </form>
</section>

@if (!Model.HasAnyStudents)
{
    <section class="odys-card odys-students-empty p-4 p-md-5 text-center" aria-label="Boş Öğrenci Listesi">
        <div class="odys-students-empty-icon mb-3" aria-hidden="true">👥</div>
        <h2 class="h5 fw-bold mb-2">Henüz öğrenciniz yok</h2>
        <p class="text-muted small mb-3">İlk öğrencinizi ekleyerek başlayın.</p>
        <a class="btn btn-primary odys-touch-target px-4 fw-semibold"
           asp-controller="Students"
           asp-action="Create">
            + İlk Öğrencinizi Ekleyin
        </a>
    </section>
}
else if (!Model.HasFilteredResults)
{
    <section class="odys-card odys-students-empty p-4 p-md-5 text-center" aria-label="Filtre Sonucu Bulunamadı">
        <h2 class="h5 fw-bold mb-2">Öğrenci bulunamadı</h2>
        <p class="text-muted small mb-3">Aramayı veya filtreleri değiştirin.</p>
        <a class="btn btn-outline-primary odys-touch-target px-4 fw-semibold"
           asp-controller="Students"
           asp-action="Index">
            Tüm Aktif Öğrencileri Göster
        </a>
    </section>
}
else
{
    <section class="odys-card odys-students-results" aria-label="Öğrenci Listesi">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 odys-students-table">
                <thead>
                    <tr>
                        <th scope="col">Öğrenci</th>
                        <th scope="col">Ders Türleri</th>
                        <th scope="col">Telefon</th>
                        <th scope="col">Durum</th>
                        <th scope="col">Not</th>
                        <th scope="col">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var student in Model.Students)
                    {
                        <tr>
                            <td class="odys-student-identity" data-label="Öğrenci">
                                <div>
                                    <a class="odys-student-name fw-semibold text-decoration-none"
                                       asp-controller="Students"
                                       asp-action="Details"
                                       asp-route-id="@student.Id">
                                        @student.FullName
                                    </a>
                                    @if (!string.IsNullOrWhiteSpace(student.Email))
                                    {
                                        <div class="small text-muted">@student.Email</div>
                                    }
                                </div>
                            </td>
                            <td data-label="Ders Türleri">
                                @if (student.ActiveSubjects.Count == 0)
                                {
                                    <span class="text-muted small">Ders atanmadı</span>
                                }
                                else
                                {
                                    <div class="d-flex flex-wrap gap-1 odys-student-subjects">
                                        @foreach (var subj in student.ActiveSubjects)
                                        {
                                            <span class="odys-student-subject">
                                                @subj.SubjectName <small>@subj.WeeklyTargetCount×@subj.DefaultDurationMinutes dk · @subj.HourlyRate.ToString("N0") ₺</small>
                                            </span>
                                        }
                                    </div>
                                }
                            </td>
                            <td data-label="Telefon">@(string.IsNullOrWhiteSpace(student.PhoneNumber) ? "—" : student.PhoneNumber)</td>
                            <td data-label="Durum">
                                @if (student.IsArchived)
                                {
                                    <span class="odys-status-pill odys-status-muted">
                                        Arşivlendi
                                    </span>
                                }
                                else
                                {
                                    <span class="odys-status-pill odys-status-active">
                                        Aktif
                                    </span>
                                }
                            </td>
                            <td class="odys-student-note text-muted small" data-label="Not">
                                <span class="d-inline-block text-truncate">
                                    @(string.IsNullOrWhiteSpace(student.Notes) ? "—" : student.Notes)
                                </span>
                            </td>
                            <td class="odys-student-actions-cell" data-label="İşlemler">
                                <div class="odys-student-actions">
                                    <a class="btn btn-outline-primary btn-sm odys-touch-target px-3"
                                       asp-controller="StudentSubjects"
                                       asp-action="Index"
                                       asp-route-studentId="@student.Id">
                                        Dersler / Ücretler
                                    </a>
                                    <a class="btn btn-outline-secondary btn-sm odys-touch-target px-3"
                                       asp-controller="Students"
                                       asp-action="Edit"
                                       asp-route-id="@student.Id">
                                        Düzenle
                                    </a>
                                    @if (student.IsArchived)
                                    {
                                        <form asp-controller="Students"
                                              asp-action="Unarchive"
                                              asp-route-id="@student.Id"
                                              method="post"
                                              class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-success btn-sm odys-touch-target px-3">
                                                Yeniden Aktif Et
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-controller="Students"
                                              asp-action="Archive"
                                              asp-route-id="@student.Id"
                                              method="post"
                                              class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-secondary btn-sm odys-touch-target px-3">
                                                Arşivle
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}
